# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# WhatsApp channel (OpenWA gateway)
# The number linked to OpenWA must be a spare one: OpenWA drives unofficial
# WhatsApp clients, and a linked number can be banned with no appeal.
# Leave unset to disable WhatsApp; inbound leads are still recorded if the
# webhook is reachable, only auto-replies are skipped.
OPENWA_BASE_URL=https://openwa.example.com
OPENWA_API_KEY=
# Optional. With several numbers connected, replies go out through whichever
# session the customer messaged; set this only to force a default.
OPENWA_SESSION_ID=
# Shared secret configured on the OpenWA webhook; requests are rejected without it.
OPENWA_WEBHOOK_SECRET=
# The WhatsApp number customers message, international format.
WHATSAPP_NUMBER=+256700000000

# Optional: forward verified Instagram webhooks to an external agent (for
# example ai-instagram-agent). Meta allows one webhook URL per app, so OpenReply
# relays instead. Leave AGENT_RELAY_URL empty to disable.
AGENT_RELAY_URL=
# Shared secret; the agent verifies x-openreply-signature with it.
AGENT_RELAY_SECRET=
# Comma-separated Instagram account ids to relay. Empty relays every account.
AGENT_RELAY_ACCOUNT_IDS=

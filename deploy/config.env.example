# OpenReply VPS deployment configuration.
#
# Copy to /etc/openreply/deploy.conf on the server. provision.sh does this for
# you on first run. Every script in deploy/ sources this file, so it is the one
# place that knows where things live and what host they answer on.

# The public hostname. Meta requires an HTTPS callback with a publicly-trusted
# certificate, so this must be a real domain with an A record pointing at this
# VPS — Let's Encrypt cannot issue a certificate for a bare IP address.
#
# Leave the placeholder until DNS is ready, then run:
#   sudo /srv/openreply/deploy/set-domain.sh openreply.yourdomain.com
DOMAIN=openreply.example.com

# Email Let's Encrypt uses for expiry warnings. Optional but recommended.
ACME_EMAIL=

# Where the checkout lives and which system user owns it.
APP_DIR=/srv/openreply
APP_USER=openreply

# The port `next start` binds to, on loopback only. Caddy terminates TLS in
# front of it, so this is never exposed to the internet directly.
APP_PORT=3000

# Repository the deploy pulls from, and the branch it tracks.
REPO_URL=https://github.com/diwenne/openreply.git
REPO_BRANCH=main

# Node major version installed from NodeSource. 22 is the current LTS.
NODE_MAJOR=22

# Postgres database and role created by provision.sh.
DB_NAME=openreply
DB_USER=openreply

# Where nightly database dumps are written, and how many to keep.
BACKUP_DIR=/var/backups/openreply
BACKUP_KEEP_DAYS=14
